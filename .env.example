# ------------------------------------------------------------------
# Indian Market Intelligence & Options Research Agent — sample .env
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit secrets.
# All keys below are optional in development; only the ones needed by the
# phases you enable must be present in production.

# --- Runtime ---
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CONFIG_PATH=config/default.yaml

# --- Market data provider (Phase 2) ---
DATA_PROVIDER=mock_replay
DATA_PROVIDER_BASE_URL=

# --- Firestore (Phase 2/3) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_DATABASE=market

# --- Gemini API (Phase 12) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-default

# --- Telegram (Phase 13) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=